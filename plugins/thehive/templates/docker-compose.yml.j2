services:
  cassandra:
    image: cassandra:4.1
    container_name: thehive-cassandra
    restart: unless-stopped
    environment:
      - CASSANDRA_START_RPC=true
      - CASSANDRA_CLUSTER_NAME=thehive
      - MAX_HEAP_SIZE=1024M
      - HEAP_NEWSIZE=256M
    volumes:
      - ./data/cassandra:/var/lib/cassandra

  minio:
    image: minio/minio:RELEASE.2023-09-07T02-05-02Z
    container_name: thehive-minio
    restart: unless-stopped
    command: server /data --console-address ":9090"
    environment:
      - MINIO_ROOT_USER=thehive
      - MINIO_ROOT_PASSWORD={{ admin_password }}
    volumes:
      - ./data/minio:/data

  thehive:
    image: strangebee/thehive:5.3
    container_name: thehive
    restart: unless-stopped
    depends_on:
      - cassandra
      - minio
    ports:
      - "{{ http_port | default(9000) }}:9000"
    environment:
      - JVM_OPTS=-Xms1024M -Xmx1024M
    volumes:
      - ./config/application.conf:/etc/thehive/application.conf:ro
      - ./data/thehive:/opt/thp/thehive/files

{% if mode == "thehive-cortex" %}
  elasticsearch-cortex:
    image: elasticsearch:7.17.12
    container_name: cortex-elasticsearch
    restart: unless-stopped
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
      - "ES_JAVA_OPTS=-Xms512m -Xmx512m"
    volumes:
      - ./data/es-cortex:/usr/share/elasticsearch/data

  cortex:
    image: thehiveproject/cortex:3.1.8
    container_name: cortex
    restart: unless-stopped
    depends_on:
      - elasticsearch-cortex
    ports:
      - "{{ cortex_port | default(9001) }}:9001"
    volumes:
      - ./config/cortex.conf:/etc/cortex/application.conf:ro
      - /var/run/docker.sock:/var/run/docker.sock
{% endif %}
