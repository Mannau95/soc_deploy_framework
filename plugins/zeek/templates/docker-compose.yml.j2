services:
  zeek:
    image: zeek/zeek:latest
    container_name: zeek
    restart: unless-stopped
    network_mode: "host"
    cap_add:
      - NET_ADMIN
      - NET_RAW
    volumes:
      - ./logs:/usr/local/zeek/logs/current
      - ./config/local.zeek:/usr/local/zeek/share/zeek/site/local.zeek:ro
    working_dir: /usr/local/zeek/logs/current
    command: >
      zeek -i {{ interface | auto_interface }} local
