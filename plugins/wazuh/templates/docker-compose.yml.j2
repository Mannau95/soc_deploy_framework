version: '3.7'

services:
  wazuh:
    image: wazuh/wazuh:4.7.5
    hostname: wazuh
    restart: always
    ports:
      - "443:443"
      - "1514:1514/udp"
      - "1515:1515"
      - "55000:55000"
    environment:
      - WAZUH_MANAGER_PASSWORD={{ admin_password }}
      - WAZUH_INDEXER_PASSWORD={{ admin_password }}
      - WAZUH_DASHBOARD_PASSWORD={{ admin_password }}
    volumes:
      - wazuh-data:/var/ossec/data
    healthcheck:
      test: ["CMD-SHELL", "curl -f -k https://localhost || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 30

volumes:
  wazuh-data: