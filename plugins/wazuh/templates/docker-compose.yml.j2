version: '3.7'

services:
  wazuh.indexer:
    image: wazuh/wazuh-indexer:4.14.0
    hostname: wazuh.indexer
    restart: always
    environment:
      - "OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m"
    volumes:
      - wazuh-indexer-data:/var/lib/wazuh-indexer
      - ./config/wazuh-indexer/opensearch.yml:/usr/share/wazuh-indexer/opensearch.yml
      - ./certs/wazuh-indexer/ca.pem:/usr/share/wazuh-indexer/certs/ca.pem
      - ./certs/wazuh-indexer/wazuh-indexer.pem:/usr/share/wazuh-indexer/certs/wazuh-indexer.pem
      - ./certs/wazuh-indexer/wazuh-indexer.key:/usr/share/wazuh-indexer/certs/wazuh-indexer.key
    healthcheck:
      test: ["CMD", "curl", "-f", "-k", "https://localhost:9200"]
      interval: 10s
      timeout: 10s
      retries: 30

  wazuh.indexer-init:
    image: wazuh/wazuh-indexer:4.14.0
    hostname: wazuh.indexer-init
    depends_on:
      wazuh.indexer:
        condition: service_healthy
    environment:
      - "OPENSEARCH_JAVA_OPTS=-Xms128m -Xmx128m"
    volumes:
      - ./certs/wazuh-indexer/ca.pem:/usr/share/wazuh-indexer/certs/ca.pem
      - ./certs/wazuh-indexer/wazuh-indexer.pem:/usr/share/wazuh-indexer/certs/wazuh-indexer.pem
      - ./certs/wazuh-indexer/wazuh-indexer.key:/usr/share/wazuh-indexer/certs/wazuh-indexer.key
      - ./config/wazuh-indexer/internal_users.yml:/usr/share/wazuh-indexer/opensearch-security/internal_users.yml
    command: >
      bash -c "
        until curl -k -u admin:admin https://wazuh.indexer:9200/_cluster/health; do sleep 10; done;
        /usr/share/wazuh-indexer/plugins/opensearch-security/tools/securityadmin.sh \
          -cd /usr/share/wazuh-indexer/opensearch-security/ \
          -icl -nhnv \
          -cacert /usr/share/wazuh-indexer/certs/ca.pem \
          -cert /usr/share/wazuh-indexer/certs/wazuh-indexer.pem \
          -key /usr/share/wazuh-indexer/certs/wazuh-indexer.key \
          -h wazuh.indexer
      "

  wazuh.manager:
    image: wazuh/wazuh-manager:4.14.0
    hostname: wazuh.manager
    restart: always
    depends_on:
      wazuh.indexer-init:
        condition: service_completed_successfully
    ports:
      - "1514:1514/udp"
      - "1515:1515"
      - "1516:1516"
      - "55000:55000"
    volumes:
      - wazuh-manager-data:/var/ossec/data
      - ./config/wazuh-manager/ossec.conf:/var/ossec/etc/ossec.conf
      - ./certs/wazuh-manager/ca.pem:/var/ossec/etc/certs/ca.pem
      - ./certs/wazuh-manager/wazuh-manager.pem:/var/ossec/etc/certs/wazuh-manager.pem
      - ./certs/wazuh-manager/wazuh-manager.key:/var/ossec/etc/certs/wazuh-manager.key
    environment:
      - "WAZUH_ALERTS_INDEX=wazuh-alerts"
    healthcheck:
      test: ["CMD", "/var/ossec/bin/wazuh-control", "status"]
      interval: 10s
      timeout: 10s
      retries: 30

  wazuh.dashboard:
    image: wazuh/wazuh-dashboard:4.14.0
    hostname: wazuh.dashboard
    restart: always
    depends_on:
      wazuh.indexer-init:
        condition: service_completed_successfully
    ports:
      - "443:5601"
    volumes:
      - ./config/wazuh-dashboard/opensearch_dashboards.yml:/usr/share/wazuh-dashboard/config/opensearch_dashboards.yml
      - ./certs/wazuh-dashboard/ca.pem:/usr/share/wazuh-dashboard/certs/ca.pem
      - ./certs/wazuh-dashboard/wazuh-dashboard.pem:/usr/share/wazuh-dashboard/certs/wazuh-dashboard.pem
      - ./certs/wazuh-dashboard/wazuh-dashboard.key:/usr/share/wazuh-dashboard/certs/wazuh-dashboard.key
    environment:
      - "DASHBOARD_USERNAME=kibanaserver"
      - "DASHBOARD_PASSWORD={{ admin_password }}"
    healthcheck:
      test: ["CMD", "curl", "-f", "-k", "https://localhost:5601"]
      interval: 10s
      timeout: 10s
      retries: 30

volumes:
  wazuh-indexer-data:
  wazuh-manager-data: